# Google Cloud Storage Configuration
# ===================================

# Your GCS bucket name where papers will be uploaded
GCS_BUCKET_NAME=your-bucket-name

# Path to your Google Cloud service account JSON credentials file
# This file should be downloaded from Google Cloud Console
GOOGLE_APPLICATION_CREDENTIALS=path/to/your-service-account-key.json

# Alternative: If running on Google Cloud Platform (GCP), you can use Application Default Credentials
# In that case, you don't need to set GOOGLE_APPLICATION_CREDENTIALS

# Optional: Google Cloud Project ID (usually not required if credentials file is set)
# GOOGLE_CLOUD_PROJECT=your-project-id
