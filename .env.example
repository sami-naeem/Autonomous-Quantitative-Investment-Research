# Google Cloud Storage Configuration
# ===================================

# Your GCS bucket name where papers will be uploaded
GCS_BUCKET_NAME=your-bucket-name

# Path to your Google Cloud service account JSON credentials file
# This file should be downloaded from Google Cloud Console
GOOGLE_APPLICATION_CREDENTIALS=path/to/your-service-account-key.json

# Alternative: If running on Google Cloud Platform (GCP), you can use Application Default Credentials
# In that case, you don't need to set GOOGLE_APPLICATION_CREDENTIALS

# Optional: Google Cloud Project ID (usually not required if credentials file is set)
# GOOGLE_CLOUD_PROJECT=your-project-id

#endpoint
HF_TOKEN={hf-token-here}

#agent necessary
OPENAI_API_KEY=sk-your-openai-api-key
LANGCHAIN_API_KEY=[your-langsmith-api-key]
# ===================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=autonomous-quant-research

# vLLM Lambda Endpoint Configuration
# ===================================
LAMBDA_ENDPOINT=http://YOUR_LAMBDA_IP:8000/v1
LAMBDA_API_KEY=token-abc123

# Model names (must match what vLLM server is serving)
# Base model: meta-llama/Meta-Llama-3-8B-Instruct
# ===================================
BASE_MODEL_NAME=llama-3-8b
FINLLAMA_MODEL_NAME=finllama
CUSTOM_MODEL_NAME=custom
